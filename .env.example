# Copy this file to backend/.env (backend) and frontend/.env.local (frontend)
# as appropriate. Never commit a real .env file — it is gitignored.

# ============================================================
# BACKEND (backend/.env)
# ============================================================

# General
APP_NAME="AI Receptionist API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database — leave unset to boot without a database (health reports
# "not_configured"). Point at your local PostgreSQL instance to enable it.
# Example: postgresql+psycopg://<user>:<password>@localhost:5432/ai_receptionist
DATABASE_URL=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:3000

# Redis — optional in Phase 1. Leave unset; the backend must run without it.
REDIS_URL=

# --- Authentication (Phase 2) ---
# Required outside development. Generate securely, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit the real value — set it only in the ignored backend/.env.
JWT_SECRET_KEY=
JWT_ISSUER=ai-receptionist
JWT_AUDIENCE=ai-receptionist-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Small, deliberate tolerance (seconds) for wall-clock disagreement between
# the process that signs an access token and the one that verifies it —
# applies only to the iat/nbf/exp checks, never to signature/issuer/
# audience. Root-caused via live reproduction: this project's dev/CI
# environment (a WSL2 VM) occasionally has its clock corrected backward by
# under a second, which PyJWT's zero-leeway default rejected as
# "not yet valid". 5s is well above the largest skew actually observed
# (~0.7s) and negligible next to the 15-minute token lifetime — see
# docs/security.md for the full incident and trade-off writeup. Do not set
# this to 0 unless you have verified your deployment environment's clocks
# never disagree even momentarily.
JWT_CLOCK_SKEW_LEEWAY_SECONDS=5

# --- Cookie security (environment-aware) ---
# Leave COOKIE_SECURE unset to auto-derive from ENVIRONMENT (secure unless
# "development"). Override explicitly only if you know you need to.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=ai_receptionist_refresh
CSRF_COOKIE_NAME=ai_receptionist_csrf

# --- AI conversation engine (Phase 4) ---
# "mock" is the only provider that actually runs without credentials — it's
# deterministic and zero-cost, so this is the correct default for local
# development, CI, and demos. Leaving AI_PROVIDER unset also defaults to
# "mock". Setting it to "openai" or "anthropic" without the matching API key
# below produces a controlled configuration error, never a silent fallback.
AI_PROVIDER=mock
AI_PROVIDER_TIMEOUT_SECONDS=30
MAX_CONVERSATION_MESSAGE_LENGTH=4000
MAX_CONVERSATION_CONTEXT_CHARS=12000
RETRIEVAL_RESULT_LIMIT=5
SSE_HEARTBEAT_SECONDS=15

# Real provider credentials — optional, and inert while AI_PROVIDER=mock.
# Never commit real values here; this file only ever holds empty placeholders.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Public embeddable widget (Phase 5) ---
# Visitor capability-token lifetime — independent of ACCESS_TOKEN_TTL_MINUTES
# above (that's the dashboard JWT). See docs/security.md.
WIDGET_VISITOR_SESSION_TTL_HOURS=24
# Hard ceiling on messages in one widget conversation, independent of rate
# limiting — bounds worst-case per-conversation cost regardless.
WIDGET_MAX_MESSAGES_PER_CONVERSATION=200
# Where the embeddable widget bundle is served from — used for the
# dashboard's "copy embed code" snippet AND its live local preview iframe,
# which actually fetches this URL. No production hosting exists yet; this
# matches docs/local-development.md's documented
# `cd widget && python3 -m http.server 5174` command (serves the whole
# widget/ directory, so the bundle is at /dist/widget.js, not bare
# /widget.js — a real deployment would typically serve it at a bare root).
WIDGET_BUNDLE_URL=http://localhost:5174/dist/widget.js
# Only set true when this app is deployed behind a proxy that itself sets
# (and strips any client-supplied) X-Forwarded-For — otherwise a visitor can
# forge this header and defeat the public widget's IP-based rate limiting.
# See app/core/client_identity.py.
TRUST_PROXY_HEADERS=false
# The dashboard's own origin(s), trusted for the "live local preview"
# feature regardless of a tenant's own allowed_domains — never merged into
# any tenant's configuration. Separate from CORS_ALLOW_ORIGINS on purpose
# even though they're the same value here; see app/config.py.
PLATFORM_PREVIEW_ORIGINS=http://localhost:3000

# --- Data retention defaults (Phase 5) ---
# Declared defaults only — no scheduled job reads these yet, so every
# record type below requires manual deletion today. See docs/security.md's
# "Retention" section. Setting these does not imply, and this product does
# not claim, compliance with any data-protection regulation.
WIDGET_VISITOR_SESSION_RETENTION_DAYS=30
WIDGET_CONVERSATION_RETENTION_DAYS=90
CONTACT_AND_ENQUIRY_RETENTION_DAYS=365
APPOINTMENT_REQUEST_RETENTION_DAYS=180
HANDOFF_REQUEST_RETENTION_DAYS=180

# ============================================================
# FRONTEND (frontend/.env.local)
# ============================================================

# Base URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match the backend's CSRF_COOKIE_NAME above — it's a cookie name, not
# a secret, so NEXT_PUBLIC_ exposure is fine.
NEXT_PUBLIC_CSRF_COOKIE_NAME=ai_receptionist_csrf

# ============================================================
# FUTURE — Phase 8+ (do not populate yet; documented for reference only)
# ============================================================

# Revenue Brain / AI Sales Employee integration credentials (Phase 8)
# REVENUE_BRAIN_API_KEY=
# AI_SALES_EMPLOYEE_API_KEY=
