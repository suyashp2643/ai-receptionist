{
  "name": "@ai-receptionist/widget",
  "version": "0.2.0",
  "private": true,
  "description": "Embeddable AI Receptionist widget (Phase 5). Talks exclusively to the public widget API surface (/api/v1/widget/*), never to internal tenant-scoped endpoints.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "esbuild": "^0.24.2",
    "vitest": "^4.1.11",
    "jsdom": "^30.0.1"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
